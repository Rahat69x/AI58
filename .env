# AI58 Platform Configuration (Local Development)
PLATFORM_NAME=AI58
PLATFORM_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=ai58-development-secret-key-super-secure-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=*

DATABASE_URL=sqlite:///./ai58.db

# Defaults to ultra-reliable built-in intelligent engine (no API key required)
AI_PROVIDER=builtin
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
